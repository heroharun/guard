<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.pcguard.guard</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__GUARD_DIR__/pc_guard.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SLACK_BOT_TOKEN</key><string>__SLACK_BOT_TOKEN__</string>
    <key>SLACK_CHANNEL</key><string>__SLACK_CHANNEL__</string>
    <key>SLACK_WEBHOOK_URL</key><string>__SLACK_WEBHOOK_URL__</string>
    <key>CAPTURE_LABEL</key><string>com.pcguard.capture</string>
    <key>PYTHONPATH</key><string>__PYTHONPATH__</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__GUARD_DIR__/pc_guard.log</string>
  <key>StandardErrorPath</key><string>__GUARD_DIR__/pc_guard.log</string>
</dict>
</plist>
